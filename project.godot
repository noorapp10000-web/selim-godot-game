; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="سليم: ساعة أبويا"
config/description="لعبة أكشن ومغامرات مصرية بأسلوب بكسل آرت - ١٢ فصل • متجر وأسلحة وتطوير"
run/main_scene="res://scenes/Intro.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.03, 0.03, 1)
boot_splash/image="res://assets/art/splash.png"
config/icon="res://icon.png"

[autoload]

Game="*res://scripts/game.gd"
Audio="*res://scripts/audio.gd"
Voice="*res://scripts/voice.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=3
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

2d/default_gravity=950.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.03, 0.05, 1)
