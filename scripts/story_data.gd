# Expression selection is shared by story scenes and in-level dialogue.
static func portrait_for(speaker: String, text: String, scene_id: String) -> String:
	var info: Array = SPEAKERS.get(speaker, ["", ""])
	var base: String = info[1]
	if base.is_empty():
		return base
	if scene_id in ["ch6_outro", "ch12_outro"] and speaker in ["selim", "father", "hassan"]:
		return base + "_happy"
	if speaker.begins_with("boss"):
		return base + ("_happy" if scene_id.ends_with("outro") else "_angry")
	if "!" in text:
		return base + "_angry"
	return base
